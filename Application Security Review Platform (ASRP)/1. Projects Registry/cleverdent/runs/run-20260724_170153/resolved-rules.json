        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Vulnerable_Dependency_Management_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-AI-001",
      "name": "BOLA/IDOR Access Control Logic Check",
      "severity": "high",
