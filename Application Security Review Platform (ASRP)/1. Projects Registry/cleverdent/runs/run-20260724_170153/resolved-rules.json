  "rules": [
    {
      "id": "ASRP-SEC-001",
      "name": "Hardcoded Generic API Key",
      "severity": "high",
      "engine": "gitleaks",
      "category": "secrets",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A07:2021-Identification and Authentication Failures"
        ],
        "cwe": [
          "CWE-798"
        ],
        "asvs_v4": [
          "V14.2.1"
        ]
      },
      "engine_config": {
        "gitleaks_rule_id": "generic-api-key",
        "regex": "(?i)(api_key|apikey|secret_key)\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-]{16,}[\"']"
      },
      "remediation": {
        "summary": "Loại bỏ secret ra khỏi mã nguồn và quản lý qua biến môi trường (.env) hoặc Secret Manager.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-SEC-002",
      "name": "Hardcoded AWS Access Key / Secret Key",
      "severity": "critical",
      "engine": "gitleaks",
      "category": "secrets",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A07:2021-Identification and Authentication Failures"
        ],
        "cwe": [
          "CWE-798"
        ],
        "asvs_v4": [
          "V14.2.1"
        ]
      },
      "engine_config": {
        "gitleaks_rule_id": "aws-access-token",
        "regex": "(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}"
      },
      "remediation": {
        "summary": "Thu hồi ngay lập tức AWS Key trên AWS IAM Console và chuyển sang sử dụng IAM Roles/Environment Variables.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-SEC-003",
      "name": "Hardcoded Private RSA/SSH Key",
      "severity": "critical",
      "engine": "gitleaks",
      "category": "secrets",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A02:2021-Cryptographic Failures",
          "A07:2021-Identification and Authentication Failures"
        ],
        "cwe": [
          "CWE-321"
        ],
        "asvs_v4": [
          "V6.4.1"
        ]
      },
      "engine_config": {
        "gitleaks_rule_id": "private-key",
        "regex": "-----BEGIN[ A-Z0-9_-]+PRIVATE KEY-----"
      },
      "remediation": {
        "summary": "Xóa Private Key khỏi Git history (dùng git-filter-repo/bfg), sinh key pair mới và đưa key vào Vault/KMS.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-SEC-004",
      "name": "Hardcoded Database Connection String with Credentials",
      "severity": "critical",
      "engine": "gitleaks",
      "category": "secrets",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A07:2021-Identification and Authentication Failures"
        ],
        "cwe": [
          "CWE-798"
        ],
        "asvs_v4": [
          "V14.2.1"
        ]
      },
      "engine_config": {
        "gitleaks_rule_id": "db-connection-string",
        "regex": "(?i)(postgres|postgresql|mysql|mongodb|redis|oracle):\\/\\/[A-Za-z0-9_]+:[^@\\s]+@[A-Za-z0-9_\\-\\.]+"
      },
      "remediation": {
        "summary": "Đưa chuỗi kết nối vào biến môi trường DATABASE_URL hoặc Secret Manager.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-INJ-001",
      "name": "SQL Injection via String Concatenation/Formatting",
      "severity": "critical",
      "engine": "semgrep",
      "category": "injection",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A03:2021-Injection"
        ],
        "cwe": [
          "CWE-89"
        ],
        "asvs_v4": [
          "V5.3.4"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "cursor.execute(f'... {$USER_INPUT} ...')"
          },
          {
            "language": "javascript",
            "pattern": "db.query('... ' + $USER_INPUT)"
          },
          {
            "language": "typescript",
            "pattern": "db.query('... ' + $USER_INPUT)"
          },
          {
            "language": "go",
            "pattern": "db.Query(fmt.Sprintf('...', $USER_INPUT))"
          },
          {
            "language": "java",
            "pattern": "stmt.executeQuery(\"... \" + $USER_INPUT)"
          }
        ]
      },
      "remediation": {
        "summary": "Sử dụng Parameterized Queries / Prepared Statements hoặc ORM (SQLAlchemy, TypeORM, GORM, Hibernate) để bind biến an toàn.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/SQL_Injection_Prevention_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-INJ-002",
      "name": "OS Command Injection via System Execution",
      "severity": "critical",
      "engine": "semgrep",
      "category": "injection",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A03:2021-Injection"
        ],
        "cwe": [
          "CWE-78"
        ],
        "asvs_v4": [
          "V5.3.8"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "subprocess.Popen(..., shell=True)"
          },
          {
            "language": "javascript",
            "pattern": "child_process.exec($CMD)"
          },
          {
            "language": "typescript",
            "pattern": "child_process.exec($CMD)"
          },
          {
            "language": "go",
            "pattern": "exec.Command(\"sh\", \"-c\", $CMD)"
          },
          {
            "language": "java",
            "pattern": "Runtime.getRuntime().exec($CMD)"
          }
        ]
      },
      "remediation": {
        "summary": "Tránh gọi shell trực tiếp. Truyền lệnh dưới dạng mảng tham số (API execFile/exec) thay vì nối chuỗi.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/OS_Command_Injection_Defense_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-PATH-001",
      "name": "Path Traversal via Unsafe File Operations",
      "severity": "high",
      "engine": "semgrep",
      "category": "access_control",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A01:2021-Broken Access Control"
        ],
        "cwe": [
          "CWE-22"
        ],
        "asvs_v4": [
          "V12.3.1"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "open(f'.../{$PATH}...')"
          },
          {
            "language": "javascript",
            "pattern": "fs.readFile($PATH, ...)"
          },
          {
            "language": "typescript",
            "pattern": "fs.readFile($PATH, ...)"
          },
          {
            "language": "go",
            "pattern": "os.Open($PATH)"
          },
          {
            "language": "java",
            "pattern": "new File($PATH)"
          }
        ]
      },
      "remediation": {
        "summary": "Validate đường dẫn bằng path.basename(), path.resolve() và kiểm tra xem có nằm ngoài thư mục root cho phép không.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/File_Path_Traversal_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-DESER-001",
      "name": "Insecure Deserialization of Untrusted Data",
      "severity": "critical",
      "engine": "semgrep",
      "category": "data_integrity",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A08:2021-Software and Data Integrity Failures"
        ],
        "cwe": [
          "CWE-502"
        ],
        "asvs_v4": [
          "V5.5.1"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "pickle.loads(...)"
          },
          {
            "language": "javascript",
            "pattern": "serialize.unserialize(...)"
          },
          {
            "language": "typescript",
            "pattern": "serialize.unserialize(...)"
          },
          {
            "language": "java",
            "pattern": "new ObjectInputStream(...).readObject()"
          }
        ]
      },
      "remediation": {
        "summary": "Dùng JSON/Protocol Buffers/Safe Parser thay cho native serialization. Cấm deserialize binary stream không tin cậy.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Deserialization_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-CRYPTO-001",
      "name": "Weak Cryptographic Hashing Algorithm (MD5/SHA1)",
      "severity": "medium",
      "engine": "semgrep",
      "category": "cryptography",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A02:2021-Cryptographic Failures"
        ],
        "cwe": [
          "CWE-327"
        ],
        "asvs_v4": [
          "V6.2.1"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "hashlib.md5(...)"
          },
          {
            "language": "javascript",
            "pattern": "crypto.createHash('md5')"
          },
          {
            "language": "typescript",
            "pattern": "crypto.createHash('md5')"
          },
          {
            "language": "go",
            "pattern": "md5.New()"
          },
          {
            "language": "java",
            "pattern": "MessageDigest.getInstance(\"MD5\")"
          }
        ]
      },
      "remediation": {
        "summary": "Nâng cấp lên SHA-256/SHA-512 cho dữ liệu thường, hoặc Argon2id/bcrypt/PBKDF2 cho mật khẩu.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Password_Storage_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-SSRF-001",
      "name": "Server-Side Request Forgery (SSRF) via HTTP Client",
      "severity": "high",
      "engine": "semgrep",
      "category": "ssrf",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A10:2021-Server-Side Request Forgery"
        ],
        "cwe": [
          "CWE-918"
        ],
        "asvs_v4": [
          "V5.2.6"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "requests.get($URL)"
          },
          {
            "language": "javascript",
            "pattern": "axios.get($URL)"
          },
          {
            "language": "typescript",
            "pattern": "fetch($URL)"
          },
          {
            "language": "go",
            "pattern": "http.Get($URL)"
          },
          {
            "language": "java",
            "pattern": "new URL($URL).openConnection()"
          }
        ]
      },
      "remediation": {
        "summary": "Validate URL domain bằng Whitelist, cấm IP nội bộ (127.0.0.1, 169.254.169.254, 10.0.0.0/8).",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Server_Side_Request_Forgery_Prevention_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-XSS-001",
      "name": "Reflected Cross-Site Scripting (XSS)",
      "severity": "high",
      "engine": "semgrep",
      "category": "injection",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A03:2021-Injection"
        ],
        "cwe": [
          "CWE-79"
        ],
        "asvs_v4": [
          "V5.3.1"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "render_template_string($USER_INPUT)"
          },
          {
            "language": "javascript",
            "pattern": "res.send(req.query.$INPUT)"
          },
          {
            "language": "typescript",
            "pattern": "res.send(req.query.$INPUT)"
          },
          {
            "language": "go",
            "pattern": "w.Write([]byte(r.FormValue($INPUT)))"
          },
          {
            "language": "java",
            "pattern": "response.getWriter().write($USER_INPUT)"
          }
        ]
      },
      "remediation": {
        "summary": "Dùng Template Engine hỗ trợ auto-escaping (Jinja2, EJS, Go html/template) hoặc thư viện sanitize-html.",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Cross_Site_Scripting_Prevention_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-MISCFG-001",
      "name": "Application Debug Mode Enabled in Production",
      "severity": "high",
      "engine": "semgrep",
      "category": "misconfiguration",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A05:2021-Security Misconfiguration"
        ],
        "cwe": [
          "CWE-215"
        ],
        "asvs_v4": [
          "V14.3.1"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "DEBUG = True"
          },
          {
            "language": "javascript",
            "pattern": "app.use(errorhandler())"
          },
          {
            "language": "typescript",
            "pattern": "app.use(errorhandler())"
          },
          {
            "language": "java",
            "pattern": "server.error.include-stacktrace=always"
          }
        ]
      },
      "remediation": {
        "summary": "Đặt DEBUG = False trên production hoặc đọc từ biến môi trường os.getenv('DEBUG').",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/Error_Handling_Cheat_Sheet.html"
      }
    },
    {
      "id": "ASRP-MISCFG-002",
      "name": "Permissive CORS Configuration (Wildcard Origin)",
      "severity": "medium",
      "engine": "semgrep",
      "category": "misconfiguration",
      "standard_mapping": {
        "owasp_top10_2021": [
          "A05:2021-Security Misconfiguration"
        ],
        "cwe": [
          "CWE-942"
        ],
        "asvs_v4": [
          "V14.4.6"
        ]
      },
      "engine_config": {
        "semgrep_patterns": [
          {
            "language": "python",
            "pattern": "CORSMiddleware(..., allow_origins=['*'], ...)"
          },
          {
            "language": "javascript",
            "pattern": "cors({ origin: '*' })"
          },
          {
            "language": "typescript",
            "pattern": "cors({ origin: '*' })"
          },
          {
            "language": "go",
            "pattern": "cors.New(cors.Options{ AllowedOrigins: []string{\"*\"} })"
          },
          {
            "language": "java",
            "pattern": "@CrossOrigin(origins = \"*\")"
          }
        ]
      },
      "remediation": {
        "summary": "Thay wildcard '*' bằng danh sách các domain tin cậy cụ thể (ví dụ: ['https://app.example.com']).",
        "reference_url": "https://cheatsheetseries.owasp.org/cheatsheets/HTML5_Security_Cheat_Sheet.html"
      }
    },
    {
